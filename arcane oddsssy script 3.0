    ESP.Players = v; ESP.Update()
end)
DropToggle(leftBody, "Mobs 🟣", false, function(v)
    ESP.Mobs = v; ESP.Update()
end)
DropToggle(leftBody, "Items 🟢", false, function(v)
    ESP.Items = v; ESP.Update()
end)

-- Chest sub-header inside left dropdown
local chestLbl = Instance.new("TextLabel")
chestLbl.Size = UDim2.new(1, 0, 0, 18)
chestLbl.BackgroundTransparency = 1
chestLbl.Text = "  ── Chests ──"
chestLbl.TextColor3 = Color3.fromRGB(160, 160, 200)
chestLbl.Font = Enum.Font.GothamBold
chestLbl.TextSize = 10
chestLbl.TextXAlignment = Enum.TextXAlignment.Left
chestLbl.Parent = leftBody

DropToggle(leftBody, "Treasure 🟡",  false, function(v) ESP.Chests.Treasure = v;  ESP.Update() end)
DropToggle(leftBody, "Rare 🔵",      false, function(v) ESP.Chests.Rare = v;      ESP.Update() end)
DropToggle(leftBody, "Uncommon 🟢",  false, function(v) ESP.Chests.Uncommon = v;  ESP.Update() end)
DropToggle(leftBody, "Legendary 🟠", false, function(v) ESP.Chests.Legendary = v; ESP.Update() end)
DropToggle(leftBody, "Sunken 🩵",    false, function(v) ESP.Chests.Sunken = v;    ESP.Update() end)
DropToggle(leftBody, "Dark 🟣",      false, function(v) ESP.Chests.Dark = v;      ESP.Update() end)
DropToggle(leftBody, "Nimbus ⚪",    false, function(v) ESP.Chests.Nimbus = v;    ESP.Update() end)
DropToggle(leftBody, "Enchanted 🩷", false, function(v) ESP.Chests.Enchanted = v; ESP.Update() end)
DropToggle(leftBody, "Crate 🟤",     false, function(v) ESP.Chests.Crate = v;     ESP.Update() end)

-- All on/off buttons inside left body
local allOnBtn = Instance.new("TextButton")
allOnBtn.Size = UDim2.new(1, 0, 0, 24)
allOnBtn.BackgroundColor3 = Color3.fromRGB(30, 70, 40)
allOnBtn.Text = "✅ All Chests ON"
allOnBtn.TextColor3 = Color3.new(1,1,1)
allOnBtn.Font = Enum.Font.Gotham
