    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    for _, obj in pairs(MapFolder:GetDescendants()) do
        if obj:IsA("BasePart") then
            local n = obj.Name:lower()
            if n:find("drop") or n:find("loot") or n:find("galleon") then
                if (root.Position - obj.Position).Magnitude < 80 then
                    root.CFrame = CFrame.new(obj.Position + Vector3.new(0,3,0))
                    task.wait(0.05)
                end
            end
        end
    end
end)

--// ── ITEM FARM DROPDOWN ────────────────────────────────────────────────
-- Dropdown containing every FARM_TARGET. Player ticks which ones they want,
-- sets a teleport interval (seconds), and starts the loop.
-- The loop cycles through all selected targets, teleports the player to each,
-- waits the interval, then loops. No movement/pathfinding — pure CFrame teleport.

UI.Label(FarmPage, "── Item Farm ──")

do
    -- State
    local farmLoop       = nil
    local farmEnabled    = false
    local farmInterval   = 5      -- seconds between teleports
    local farmSelected   = {}     -- [index] = true/false
    for i = 1, #FARM_TARGETS do farmSelected[i] = false end

    -- ── Dropdown header ─────────────────────────────────────────────────
    local farmDropBtn = Instance.new("TextButton")
    farmDropBtn.Size = UDim2.new(1, 0, 0, 30)
    farmDropBtn.BackgroundColor3 = Color3.fromRGB(40, 55, 100)
    farmDropBtn.Text = "▶  Select Farm Targets"
    farmDropBtn.TextColor3 = Color3.new(1,1,1)
    farmDropBtn.Font = Enum.Font.GothamBold
    farmDropBtn.TextSize = 12
    farmDropBtn.TextXAlignment = Enum.TextXAlignment.Left
    farmDropBtn.Parent = FarmPage
    Instance.new("UICorner", farmDropBtn).CornerRadius = UDim.new(0, 6)
    do
        local s = Instance.new("UIStroke")
        s.Color = Color3.fromRGB(70, 100, 180)
        s.Thickness = 1
        s.Parent = farmDropBtn
        local p = Instance.new("UIPadding")
        p.PaddingLeft = UDim.new(0, 8)
        p.Parent = farmDropBtn
    end

    -- ── Dropdown body ────────────────────────────────────────────────────
    local farmDropBody = Instance.new("Frame")
    farmDropBody.Size = UDim2.new(1, 0, 0, 0)
    farmDropBody.AutomaticSize = Enum.AutomaticSize.Y
    farmDropBody.BackgroundColor3 = Color3.fromRGB(20, 20, 32)
    farmDropBody.Visible = false
    farmDropBody.Parent = FarmPage
    Instance.new("UICorner", farmDropBody).CornerRadius = UDim.new(0, 5)
    do
        local bl = Instance.new("UIListLayout")
        bl.Padding = UDim.new(0, 3)
        bl.Parent = farmDropBody
        local bp = Instance.new("UIPadding")
        bp.PaddingLeft = UDim.new(0, 4)
        bp.PaddingRight = UDim.new(0, 4)
        bp.PaddingTop = UDim.new(0, 4)
        bp.PaddingBottom = UDim.new(0, 4)
        bp.Parent = farmDropBody
    end

    -- Toggle open/close
    local farmDropOpen = false
    farmDropBtn.MouseButton1Click:Connect(function()
        farmDropOpen = not farmDropOpen
        farmDropBody.Visible = farmDropOpen
        farmDropBtn.Text = (farmDropOpen and "▼  " or "▶  ") .. "Select Farm Targets"
    end)

    -- One toggle per FARM_TARGET inside the body
    for i, target in ipairs(FARM_TARGETS) do
        local tb = Instance.new("TextButton")
        tb.Size = UDim2.new(1, 0, 0, 26)
        tb.BackgroundColor3 = Color3.fromRGB(55, 28, 28)
        tb.Text = target.label .. "  [OFF]"
        tb.TextColor3 = Color3.new(1,1,1)
        tb.Font = Enum.Font.Gotham
        tb.TextSize = 10
        tb.Parent = farmDropBody
        Instance.new("UICorner", tb).CornerRadius = UDim.new(0, 4)
        local ts = Instance.new("UIStroke")
        ts.Color = Color3.fromRGB(160,60,60)
        ts.Thickness = 1
        ts.Parent = tb
        tb.MouseButton1Click:Connect(function()
            farmSelected[i] = not farmSelected[i]
            local on = farmSelected[i]
            tb.Text = target.label .. "  [" .. (on and "ON" or "OFF") .. "]"
            tb.BackgroundColor3 = on and Color3.fromRGB(30,80,50) or Color3.fromRGB(55,28,28)
            ts.Color = on and Color3.fromRGB(60,160,90) or Color3.fromRGB(160,60,60)
        end)
    end

    -- ── Teleport interval: slider + clickable number ─────────────────────
    local intervalFrame = Instance.new("Frame")
    intervalFrame.Size = UDim2.new(1, 0, 0, 56)
    intervalFrame.BackgroundColor3 = Color3.fromRGB(28, 28, 40)
    intervalFrame.Parent = FarmPage
    Instance.new("UICorner", intervalFrame).CornerRadius = UDim.new(0, 6)

    local intLbl = Instance.new("TextLabel")
    intLbl.Size = UDim2.new(0.62, 0, 0, 22)
    intLbl.Position = UDim2.new(0, 8, 0, 2)
    intLbl.BackgroundTransparency = 1
    intLbl.Text = "Teleport Interval (sec)"
    intLbl.TextColor3 = Color3.new(1,1,1)
    intLbl.Font = Enum.Font.Gotham
    intLbl.TextSize = 12
    intLbl.TextXAlignment = Enum.TextXAlignment.Left
    intLbl.Parent = intervalFrame

    local intNumBtn = Instance.new("TextButton")
    intNumBtn.Size = UDim2.new(0.36, -8, 0, 22)
    intNumBtn.Position = UDim2.new(0.64, 0, 0, 2)
    intNumBtn.BackgroundColor3 = Color3.fromRGB(40, 50, 80)
    intNumBtn.Text = tostring(farmInterval)
    intNumBtn.TextColor3 = Color3.fromRGB(130, 200, 255)
    intNumBtn.Font = Enum.Font.GothamBold
    intNumBtn.TextSize = 12
    intNumBtn.Parent = intervalFrame
    Instance.new("UICorner", intNumBtn).CornerRadius = UDim.new(0, 4)

    local intTrack = Instance.new("Frame")
    intTrack.Size = UDim2.new(1, -16, 0, 6)
    intTrack.Position = UDim2.new(0, 8, 0, 32)
    intTrack.BackgroundColor3 = Color3.fromRGB(40, 40, 60)
    intTrack.Parent = intervalFrame
    Instance.new("UICorner", intTrack).CornerRadius = UDim.new(0, 3)

    local INT_MIN, INT_MAX = 1, 120
    local intFill = Instance.new("Frame")
    intFill.Size = UDim2.new((farmInterval - INT_MIN)/(INT_MAX - INT_MIN), 0, 1, 0)
    intFill.BackgroundColor3 = Color3.fromRGB(80, 140, 255)
    intFill.Parent = intTrack
    Instance.new("UICorner", intFill).CornerRadius = UDim.new(0, 3)

    local function applyInterval(v)
        v = math.clamp(math.floor(v), INT_MIN, INT_MAX)
        farmInterval = v
        intNumBtn.Text = tostring(v)
        intFill.Size = UDim2.new((v - INT_MIN)/(INT_MAX - INT_MIN), 0, 1, 0)
    end

    local draggingInt = false
    intTrack.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then draggingInt = true end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then draggingInt = false end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if draggingInt and i.UserInputType == Enum.UserInputType.MouseMovement then
            local rel = math.clamp((i.Position.X - intTrack.AbsolutePosition.X)/intTrack.AbsoluteSize.X, 0, 1)
            applyInterval(INT_MIN + (INT_MAX - INT_MIN) * rel)
        end
    end)

    intNumBtn.MouseButton1Click:Connect(function()
        local box = Instance.new("TextBox")
        box.Size = intNumBtn.Size
        box.Position = intNumBtn.Position
        box.BackgroundColor3 = Color3.fromRGB(20,30,60)
        box.Text = tostring(farmInterval)
        box.TextColor3 = Color3.new(1,1,1)
        box.Font = Enum.Font.GothamBold
        box.TextSize = 12
        box.ClearTextOnFocus = true
        box.Parent = intervalFrame
        Instance.new("UICorner", box).CornerRadius = UDim.new(0, 4)
        intNumBtn.Visible = false
        box:CaptureFocus()
        box.FocusLost:Connect(function()
            local t = tonumber(box.Text)
            if t then applyInterval(t) end
            box:Destroy()
            intNumBtn.Visible = true
        end)
    end)

    -- ── Start / Stop buttons ─────────────────────────────────────────────
    local farmStartBtn = Instance.new("TextButton")
    farmStartBtn.Size = UDim2.new(1, 0, 0, 32)
    farmStartBtn.BackgroundColor3 = Color3.fromRGB(30, 80, 50)
    farmStartBtn.Text = "▶  Start Item Farm"
    farmStartBtn.TextColor3 = Color3.new(1,1,1)
    farmStartBtn.Font = Enum.Font.GothamBold
    farmStartBtn.TextSize = 12
    farmStartBtn.Parent = FarmPage
    Instance.new("UICorner", farmStartBtn).CornerRadius = UDim.new(0, 6)
    Instance.new("UIStroke", farmStartBtn).Color = Color3.fromRGB(60,160,90)

    local farmStopBtn = Instance.new("TextButton")
    farmStopBtn.Size = UDim2.new(1, 0, 0, 32)
    farmStopBtn.BackgroundColor3 = Color3.fromRGB(80, 30, 30)
    farmStopBtn.Text = "■  Stop Item Farm"
    farmStopBtn.TextColor3 = Color3.new(1,1,1)
    farmStopBtn.Font = Enum.Font.GothamBold
    farmStopBtn.TextSize = 12
    farmStopBtn.Parent = FarmPage
    Instance.new("UICorner", farmStopBtn).CornerRadius = UDim.new(0, 6)
    Instance.new("UIStroke", farmStopBtn).Color = Color3.fromRGB(160,60,60)

    local farmStatusLbl = Instance.new("TextLabel")
    farmStatusLbl.Size = UDim2.new(1, 0, 0, 20)
    farmStatusLbl.BackgroundTransparency = 1
    farmStatusLbl.Text = "  Status: Stopped"
    farmStatusLbl.TextColor3 = Color3.fromRGB(150, 150, 180)
    farmStatusLbl.Font = Enum.Font.Gotham
    farmStatusLbl.TextSize = 11
    farmStatusLbl.TextXAlignment = Enum.TextXAlignment.Left
    farmStatusLbl.Parent = FarmPage

    local function stopFarm()
        farmEnabled = false
        if farmLoop then farmLoop:Disconnect() farmLoop = nil end
        farmStatusLbl.Text = "  Status: Stopped"
    end

    local function startFarm()
        -- Build active list from selected targets
        local active = {}
        for i, target in ipairs(FARM_TARGETS) do
            if farmSelected[i] then table.insert(active, target) end
        end
        if #active == 0 then
            farmStatusLbl.Text = "  ⚠ No targets selected!"
            return
        end

        farmEnabled = true
        local idx = 1
        local lastTP = 0

        if farmLoop then farmLoop:Disconnect() end
        farmLoop = RunService.Heartbeat:Connect(function()
            if not farmEnabled then return end
            local now = tick()
            if now - lastTP < farmInterval then return end
            lastTP = now

            local target = active[idx]
            idx = (idx % #active) + 1  -- advance, wrap around

            local char = player.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if not root then return end

            pcall(function()
                local part = target.get()
                if part and part:IsA("BasePart") then
                    root.CFrame = CFrame.new(part.Position + Vector3.new(0, 3, 0))
                    farmStatusLbl.Text = "  ✅ → " .. target.label
                else
                    farmStatusLbl.Text = "  ⚠ Not found: " .. target.label
                end
            end)
        end)
        AddConn(farmLoop)
        farmStatusLbl.Text = "  ▶ Farming " .. #active .. " target(s)..."
    end

    farmStartBtn.MouseButton1Click:Connect(startFarm)
    farmStopBtn.MouseButton1Click:Connect(stopFarm)
end

--// ===== ESP TAB =====
-- Two-column layout: Left = ESP toggles dropdown, Right = per-item distance dropdown
-- Both dropdowns live inside the existing ESPPage ScrollingFrame.
-- The ESP module data (ESP.Players, ESP.Mobs, etc.) is unchanged.

-- ── Per-item distance table (studs, 0 = uses global, stored separately from ESP.MaxDistance)
local ESPItemDist = {
    Players   = 0,
    Mobs      = 0,
    Items     = 0,
    Treasure  = 0,
    Rare      = 0,
    Uncommon  = 0,
    Legendary = 0,
    Sunken    = 0,
    Dark      = 0,
    Nimbus    = 0,
    Enchanted = 0,
    Crate     = 0,
}

-- Patch ESP.Update to use per-item distances when set (>0), else fall back to ESP.MaxDistance
-- We override the InRange helper defined earlier by wrapping it per-call inside Update.
-- (The original InRange still works for the global path; here we pass an explicit limit.)
local _origESPUpdate = ESP.Update
ESP.Update = function()
    -- Temporarily swap MaxDistance per item during each highlight call
    -- by running each section with its own distance cap.
    ESP.Clear()
    if not ESP.Enabled then return end

    local function inRangeDist(part, dist)
        local cap = (dist and dist > 0) and dist or (ESP.MaxDistance > 0 and ESP.MaxDistance or math.huge)
        local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        if not root then return true end
        return (root.Position - part.Position).Magnitude <= cap
    end

    if ESP.Players then
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= player and p.Character then
                local char = p.Character
                local root = char:FindFirstChild("HumanoidRootPart")
                local hum  = char:FindFirstChildOfClass("Humanoid")
                if root and inRangeDist(root, ESPItemDist.Players) then
                    PlaceHighlight(char, Color3.fromRGB(255, 80, 80), 0.6)
                    local name = p.DisplayName ~= "" and p.DisplayName or p.Name
                    local hp   = "HP: ?"
                    local awk  = "Awakening: ?"
                    if hum then
                        hp = "HP: "..math.floor(hum.Health).." / "..math.floor(hum.MaxHealth)
                    end
                    pcall(function()
                        local pData = p:FindFirstChild("Data") or p:FindFirstChild("PlayerData")
                        if pData then
                            local aw = pData:FindFirstChild("Awakening") or pData:FindFirstChild("Awoken")
                            if aw then awk = "Awakening: "..tostring(aw.Value) end
                        end
                        local awAttr = char:GetAttribute("Awakening") or char:GetAttribute("Awoken")
                        if awAttr ~= nil then awk = "Awakening: "..tostring(awAttr) end
                    end)
                    PlaceLabel(root, {"👤 "..name, hp, awk}, Color3.fromRGB(255, 160, 160))
                end
            end
        end
    end

    if ESP.Mobs then
        for _, enemy in pairs(EnemiesFolder:GetChildren()) do
            local root = enemy:FindFirstChild("HumanoidRootPart")
            local hum  = enemy:FindFirstChildOfClass("Humanoid")
            if root and inRangeDist(root, ESPItemDist.Mobs) then
                PlaceHighlight(enemy, Color3.fromRGB(200, 80, 255), 0.65)
                local hp = hum and (math.floor(hum.Health).."/"..math.floor(hum.MaxHealth)) or "?"
                PlaceLabel(root, {"⚔ "..enemy.Name, "HP: "..hp}, Color3.fromRGB(220, 150, 255))
            end
        end
    end

    if ESP.Items then
        local seenI = {}
        local items = ScanWorkspaceForItems(ITEM_SCAN_PATTERNS)
        for _, obj in pairs(items) do
            if inRangeDist(obj, ESPItemDist.Items) and not seenI[obj] then
                seenI[obj] = true
                PlaceHighlight(obj, Color3.fromRGB(80, 255, 160), 0.4)
                PlaceLabel(obj, {"💎 "..obj.Name}, Color3.fromRGB(80, 255, 160))
            end
        end
        -- Static paths (confirmed from workspace scan)
        for _, entry in ipairs(STATIC_ITEM_PATHS) do
            if not entry.isFolder then
                local obj = entry.get()
                if obj and not seenI[obj] then
                    local refPart = obj:IsA("BasePart") and obj
                        or obj:FindFirstChildWhichIsA("BasePart", true)
                    if refPart and inRangeDist(refPart, ESPItemDist.Items) then
                        seenI[obj] = true
                        PlaceHighlight(obj, Color3.fromRGB(80, 255, 160), 0.4)
                        PlaceLabel(refPart, {"🌿 "..entry.label}, Color3.fromRGB(80, 255, 160))
                    end
                end
            else
                local folder = entry.get()
                if folder then
                    for _, child in pairs(folder:GetChildren()) do
                        if child:IsA("BasePart") and not seenI[child]
                            and inRangeDist(child, ESPItemDist.Items) then
                            seenI[child] = true
                            PlaceHighlight(child, Color3.fromRGB(80, 255, 160), 0.4)
                            PlaceLabel(child, {"🌿 "..entry.label}, Color3.fromRGB(80, 255, 160))
                        end
                    end
                end
            end
        end
    end

    local anyChest = false
    for _, ct in pairs(ESP.Chests) do if ct then anyChest = true break end end
    if anyChest then
        for _, chestType in ipairs(CHEST_TYPES) do
            if ESP.Chests[chestType.key] then
                local found = ScanForChests(MapFolder, chestType.pattern)
                for _, obj in pairs(found) do
                    local refPart = obj:IsA("BasePart") and obj
                        or obj:FindFirstChildWhichIsA("BasePart", true)
                    if refPart and inRangeDist(refPart, ESPItemDist[chestType.key]) then
                        PlaceHighlight(obj, chestType.color, 0.45)
                        PlaceLabel(refPart, {"📦 "..chestType.label}, chestType.color)
                    end
                end
            end
        end
    end
end

-- ── Master toggle (sits above both columns, full width) ──────────────────
UI.Label(ESPPage, "── ESP ──")
UI.Toggle(ESPPage, "ESP Master Switch", false, function(v)
    ESP.Enabled = v
    if not v then ESP.Clear() else ESP.Update() end
end)

-- ── Two-column row ───────────────────────────────────────────────────────
-- We create one Frame as a row container, then two child frames side by side.
-- The row itself is parented directly into ESPPage so the UIListLayout picks it up.

local espRow = Instance.new("Frame")
espRow.Size = UDim2.new(1, 0, 0, 600)   -- tall enough; clips to content via AutomaticSize
espRow.AutomaticSize = Enum.AutomaticSize.Y
espRow.BackgroundTransparency = 1
espRow.Parent = ESPPage

-- LEFT column — ESP type toggles dropdown
local leftCol = Instance.new("Frame")
leftCol.Size = UDim2.new(0.49, -2, 0, 0)
leftCol.AutomaticSize = Enum.AutomaticSize.Y
leftCol.Position = UDim2.new(0, 0, 0, 0)
leftCol.BackgroundTransparency = 1
leftCol.Parent = espRow

local leftLayout = Instance.new("UIListLayout")
leftLayout.Padding = UDim.new(0, 4)
leftLayout.Parent = leftCol

-- RIGHT column — per-item distance dropdown
local rightCol = Instance.new("Frame")
rightCol.Size = UDim2.new(0.49, -2, 0, 0)
rightCol.AutomaticSize = Enum.AutomaticSize.Y
rightCol.Position = UDim2.new(0.51, 0, 0, 0)
rightCol.BackgroundTransparency = 1
