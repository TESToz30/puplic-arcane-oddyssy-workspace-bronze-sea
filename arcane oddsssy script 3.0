rightLayout.Parent = rightCol

-- ── Shared builder helpers ────────────────────────────────────────────────

local function MakeDropHeader(parent, labelText, color)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 30)
    btn.BackgroundColor3 = color or Color3.fromRGB(35, 45, 80)
    btn.Text = "▶  "..labelText
    btn.TextColor3 = Color3.new(1,1,1)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 11
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.Parent = parent
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 5)
    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(70, 100, 180)
    stroke.Thickness = 1
    stroke.Parent = btn
    local pad = Instance.new("UIPadding")
    pad.PaddingLeft = UDim.new(0, 8)
    pad.Parent = btn
    return btn
end

local function MakeDropBody(parent)
    local body = Instance.new("Frame")
    body.Size = UDim2.new(1, 0, 0, 0)
    body.AutomaticSize = Enum.AutomaticSize.Y
    body.BackgroundColor3 = Color3.fromRGB(20, 20, 32)
    body.Visible = false
    body.Parent = parent
    Instance.new("UICorner", body).CornerRadius = UDim.new(0, 5)
    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, 3)
    layout.Parent = body
    local pad = Instance.new("UIPadding")
    pad.PaddingLeft = UDim.new(0, 4)
    pad.PaddingRight = UDim.new(0, 4)
    pad.PaddingTop = UDim.new(0, 4)
    pad.PaddingBottom = UDim.new(0, 4)
    pad.Parent = body
    return body
end

local function WireDropdown(header, body)
    local open = false
    header.MouseButton1Click:Connect(function()
        open = not open
        body.Visible = open
        header.Text = (open and "▼  " or "▶  ") .. header.Text:sub(4)
    end)
end

-- Small toggle inside a dropdown body
local function DropToggle(parent, text, default, callback)
    local state = default or false
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, 0, 0, 26)
    b.BackgroundColor3 = state and Color3.fromRGB(30, 80, 50) or Color3.fromRGB(55, 28, 28)
    b.Text = text.."  ["..(state and "ON" or "OFF").."]"
    b.TextColor3 = Color3.new(1,1,1)
    b.Font = Enum.Font.Gotham
    b.TextSize = 10
    b.Parent = parent
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 4)
    local stroke = Instance.new("UIStroke")
    stroke.Color = state and Color3.fromRGB(60,160,90) or Color3.fromRGB(160,60,60)
    stroke.Thickness = 1
    stroke.Parent = b
    b.MouseButton1Click:Connect(function()
        state = not state
        b.Text = text.."  ["..(state and "ON" or "OFF").."]"
        b.BackgroundColor3 = state and Color3.fromRGB(30,80,50) or Color3.fromRGB(55,28,28)
        stroke.Color = state and Color3.fromRGB(60,160,90) or Color3.fromRGB(160,60,60)
        callback(state)
    end)
    return b
end

-- Per-item distance slider with clickable number display
-- Range 1–9999999, shows current value, click number to type
local function DropDistSlider(parent, label, key)
    local val = ESPItemDist[key] or 0
    local MIN, MAX = 1, 9999999

    local container = Instance.new("Frame")
    container.Size = UDim2.new(1, 0, 0, 56)
    container.BackgroundColor3 = Color3.fromRGB(24, 24, 36)
    container.Parent = parent
    Instance.new("UICorner", container).CornerRadius = UDim.new(0, 4)

    -- Label row
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(0.62, 0, 0, 18)
    lbl.Position = UDim2.new(0, 4, 0, 2)
    lbl.BackgroundTransparency = 1
    lbl.Text = label
    lbl.TextColor3 = Color3.fromRGB(180, 200, 255)
    lbl.Font = Enum.Font.GothamBold
    lbl.TextSize = 10
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = container

    -- Clickable number badge — click to type custom value
    local numBtn = Instance.new("TextButton")
    numBtn.Size = UDim2.new(0.36, -4, 0, 18)
    numBtn.Position = UDim2.new(0.64, 0, 0, 2)
    numBtn.BackgroundColor3 = Color3.fromRGB(40, 50, 80)
    numBtn.Text = val == 0 and "∞" or tostring(val)
    numBtn.TextColor3 = Color3.fromRGB(130, 200, 255)
    numBtn.Font = Enum.Font.GothamBold
    numBtn.TextSize = 10
    numBtn.Parent = container
    Instance.new("UICorner", numBtn).CornerRadius = UDim.new(0, 3)

    -- Track bar
    local track = Instance.new("Frame")
    track.Size = UDim2.new(1, -8, 0, 6)
    track.Position = UDim2.new(0, 4, 0, 26)
    track.BackgroundColor3 = Color3.fromRGB(40, 40, 60)
    track.Parent = container
    Instance.new("UICorner", track).CornerRadius = UDim.new(0, 3)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(val > 0 and ((val - MIN) / (MAX - MIN)) or 0, 0, 1, 0)
    fill.BackgroundColor3 = Color3.fromRGB(80, 140, 255)
    fill.Parent = track
    Instance.new("UICorner", fill).CornerRadius = UDim.new(0, 3)

    -- "0 = ∞" hint
    local hint = Instance.new("TextLabel")
    hint.Size = UDim2.new(1, -8, 0, 12)
    hint.Position = UDim2.new(0, 4, 0, 42)
    hint.BackgroundTransparency = 1
    hint.Text = "0 / drag = ∞ (no limit)  |  click # to type"
    hint.TextColor3 = Color3.fromRGB(100, 100, 130)
    hint.Font = Enum.Font.Gotham
    hint.TextSize = 8
    hint.TextXAlignment = Enum.TextXAlignment.Left
    hint.Parent = container

    local function applyVal(v)
        v = math.clamp(math.floor(v), 0, MAX)
        val = v
        ESPItemDist[key] = v
        numBtn.Text = (v == 0) and "∞" or tostring(v)
        local pct = (v > 0) and ((v - MIN) / (MAX - MIN)) or 0
        fill.Size = UDim2.new(math.clamp(pct, 0, 1), 0, 1, 0)
        if ESP.Enabled then ESP.Update() end
    end

    -- Drag slider
    local draggingSlider = false
    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            draggingSlider = true
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            draggingSlider = false
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if draggingSlider and input.UserInputType == Enum.UserInputType.MouseMovement then
            local rel = math.clamp(
                (input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
            applyVal(MIN + (MAX - MIN) * rel)
        end
    end)

    -- Click number to type custom value
    numBtn.MouseButton1Click:Connect(function()
        -- Replace numBtn temporarily with a TextBox
        local box = Instance.new("TextBox")
        box.Size = numBtn.Size
        box.Position = numBtn.Position
        box.BackgroundColor3 = Color3.fromRGB(20, 30, 60)
        box.Text = (val == 0) and "0" or tostring(val)
        box.TextColor3 = Color3.fromRGB(255, 255, 255)
        box.Font = Enum.Font.GothamBold
        box.TextSize = 10
        box.ClearTextOnFocus = true
        box.Parent = container
        Instance.new("UICorner", box).CornerRadius = UDim.new(0, 3)
        numBtn.Visible = false
        box:CaptureFocus()
        box.FocusLost:Connect(function(enter)
            local typed = tonumber(box.Text)
            if typed then applyVal(typed) end
            box:Destroy()
            numBtn.Visible = true
        end)
    end)

    return container
end

-- ── LEFT COLUMN: ESP Toggles Dropdown ────────────────────────────────────

local leftHeader = MakeDropHeader(leftCol, "ESP Items", Color3.fromRGB(40, 55, 100))
local leftBody   = MakeDropBody(leftCol)
WireDropdown(leftHeader, leftBody)

