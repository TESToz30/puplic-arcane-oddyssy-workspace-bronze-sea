    { pattern = "rare chest",      label = "Rare Chest",      color = Color3.fromRGB(100, 180, 255), key = "Rare"      },
    { pattern = "uncommon chest",  label = "Uncommon Chest",  color = Color3.fromRGB(80, 220, 120),  key = "Uncommon"  },
    { pattern = "legendary chest", label = "Legendary Chest", color = Color3.fromRGB(255, 120, 0),   key = "Legendary" },
    { pattern = "sunken chest",    label = "Sunken Chest",    color = Color3.fromRGB(60, 180, 255),  key = "Sunken"    },
    { pattern = "dark chest",      label = "Dark Chest",      color = Color3.fromRGB(160, 60, 220),  key = "Dark"      },
    { pattern = "nimbus chest",    label = "Nimbus Chest",    color = Color3.fromRGB(200, 230, 255), key = "Nimbus"    },
    { pattern = "enchanted chest", label = "Enchanted Chest", color = Color3.fromRGB(255, 80, 200),  key = "Enchanted" },
