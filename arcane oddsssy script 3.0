-- Fly speed: slider 0-8000 + clickable number badge to type
do
    local flySpd = Fly.Speed
    local FLY_MIN, FLY_MAX = 0, 8000

    local flyFrame = Instance.new("Frame")
    flyFrame.Size = UDim2.new(1, 0, 0, 56)
    flyFrame.BackgroundColor3 = Color3.fromRGB(28, 28, 40)
    flyFrame.Parent = PlayerPage
    Instance.new("UICorner", flyFrame).CornerRadius = UDim.new(0, 6)

    local flyLbl = Instance.new("TextLabel")
    flyLbl.Size = UDim2.new(0.62, 0, 0, 22)
    flyLbl.Position = UDim2.new(0, 8, 0, 2)
    flyLbl.BackgroundTransparency = 1
    flyLbl.Text = "Fly Speed (studs/s)"
    flyLbl.TextColor3 = Color3.new(1,1,1)
    flyLbl.Font = Enum.Font.Gotham
    flyLbl.TextSize = 12
    flyLbl.TextXAlignment = Enum.TextXAlignment.Left
    flyLbl.Parent = flyFrame

    local flyNumBtn = Instance.new("TextButton")
    flyNumBtn.Size = UDim2.new(0.36, -8, 0, 22)
    flyNumBtn.Position = UDim2.new(0.64, 0, 0, 2)
    flyNumBtn.BackgroundColor3 = Color3.fromRGB(40, 50, 80)
    flyNumBtn.Text = tostring(flySpd)
    flyNumBtn.TextColor3 = Color3.fromRGB(130, 200, 255)
    flyNumBtn.Font = Enum.Font.GothamBold
    flyNumBtn.TextSize = 12
    flyNumBtn.Parent = flyFrame
    Instance.new("UICorner", flyNumBtn).CornerRadius = UDim.new(0, 4)

    local flyTrack = Instance.new("Frame")
    flyTrack.Size = UDim2.new(1, -16, 0, 6)
    flyTrack.Position = UDim2.new(0, 8, 0, 32)
    flyTrack.BackgroundColor3 = Color3.fromRGB(40, 40, 60)
    flyTrack.Parent = flyFrame
    Instance.new("UICorner", flyTrack).CornerRadius = UDim.new(0, 3)

    local flyFill = Instance.new("Frame")
    flyFill.Size = UDim2.new(flySpd / FLY_MAX, 0, 1, 0)
    flyFill.BackgroundColor3 = Color3.fromRGB(80, 180, 255)
    flyFill.Parent = flyTrack
    Instance.new("UICorner", flyFill).CornerRadius = UDim.new(0, 3)

    local function applyFlySpeed(v)
        v = math.clamp(math.floor(v), FLY_MIN, FLY_MAX)
        flySpd = v
        Fly.Speed = v
        flyNumBtn.Text = tostring(v)
        flyFill.Size = UDim2.new(v / FLY_MAX, 0, 1, 0)
    end

    local draggingFly = false
    flyTrack.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then draggingFly = true end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then draggingFly = false end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if draggingFly and i.UserInputType == Enum.UserInputType.MouseMovement then
            local rel = math.clamp((i.Position.X - flyTrack.AbsolutePosition.X) / flyTrack.AbsoluteSize.X, 0, 1)
            applyFlySpeed(FLY_MIN + (FLY_MAX - FLY_MIN) * rel)
        end
    end)

    -- Click number to type
    flyNumBtn.MouseButton1Click:Connect(function()
        local box = Instance.new("TextBox")
        box.Size = flyNumBtn.Size
        box.Position = flyNumBtn.Position
        box.BackgroundColor3 = Color3.fromRGB(20, 30, 60)
        box.Text = tostring(flySpd)
        box.TextColor3 = Color3.new(1,1,1)
        box.Font = Enum.Font.GothamBold
        box.TextSize = 12
        box.ClearTextOnFocus = true
        box.Parent = flyFrame
        Instance.new("UICorner", box).CornerRadius = UDim.new(0, 4)
        flyNumBtn.Visible = false
        box:CaptureFocus()
        box.FocusLost:Connect(function()
            local t = tonumber(box.Text)
            if t then applyFlySpeed(t) end
            box:Destroy()
            flyNumBtn.Visible = true
        end)
    end)
end

-- Set custom keybind button
local keybindBtn = Instance.new("TextButton")
keybindBtn.Size = UDim2.new(1, 0, 0, 34)
keybindBtn.BackgroundColor3 = Color3.fromRGB(35, 45, 75)
keybindBtn.Text = "Set Fly Keybind  (current: " .. tostring(Fly.Keybind.Name) .. ")"
keybindBtn.TextColor3 = Color3.new(1,1,1)
keybindBtn.Font = Enum.Font.Gotham
keybindBtn.TextSize = 12
keybindBtn.Parent = PlayerPage
Instance.new("UICorner", keybindBtn).CornerRadius = UDim.new(0, 6)
Instance.new("UIStroke", keybindBtn).Color = Color3.fromRGB(60, 90, 160)
do
    local listening = false
    local listenConn
    keybindBtn.MouseButton1Click:Connect(function()
        if listening then return end
        listening = true
        keybindBtn.Text = "▶  Press any key..."
        keybindBtn.BackgroundColor3 = Color3.fromRGB(70, 50, 20)
        if listenConn then listenConn:Disconnect() end
        listenConn = UserInputService.InputBegan:Connect(function(input, gpe)
            if gpe then return end
            if input.UserInputType == Enum.UserInputType.Keyboard then
                Fly.Keybind = input.KeyCode
                keybindBtn.Text = "Set Fly Keybind  (current: " .. tostring(input.KeyCode.Name) .. ")"
                flyToggleBtn.Text = "Fly  [" .. (Fly.Enabled and "ON" or "OFF") .. "]  (Key: " .. tostring(input.KeyCode.Name) .. ")"
                keybindBtn.BackgroundColor3 = Color3.fromRGB(35, 45, 75)
                listening = false
                listenConn:Disconnect()
            end
        end)
    end)
end

