UI.Button(CombatPage, "Teleport Behind Nearest Enemy", function()
    local target = GetNearestEnemy()
    if not target then return end
    local tRoot = target:FindFirstChild("HumanoidRootPart")
    local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if tRoot and root then root.CFrame = tRoot.CFrame * CFrame.new(0, 0, 3) end
end)
UI.Button(CombatPage, "Face Nearest Enemy", function()
    local target = GetNearestEnemy()
    if not target then return end
    local tRoot = target:FindFirstChild("HumanoidRootPart")
    local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if tRoot and root then root.CFrame = CFrame.lookAt(root.Position, tRoot.Position) end
end)

UI.Label(CombatPage, "── Enemy List (Bronze Sea) ──")
for _, name in pairs(ENEMY_NAMES) do
    UI.Button(CombatPage, "→ TP to " .. name, function()
        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root then return end
        for _, enemy in pairs(EnemiesFolder:GetChildren()) do
            if enemy.Name == name then
                local eRoot = enemy:FindFirstChild("HumanoidRootPart")
                if eRoot then
                    root.CFrame = CFrame.new(eRoot.Position + Vector3.new(3, 0, 0))
                    return
                end
            end
        end
    end)
end

