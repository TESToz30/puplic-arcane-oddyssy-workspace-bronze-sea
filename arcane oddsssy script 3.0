UI.Button(TeleportPage, "Teleport to Mouse", Features.TeleportToMouse)
UI.Button(TeleportPage, "Teleport to Nearest Enemy", Features.TeleportToNearestEnemy)
UI.Button(TeleportPage, "Teleport to Nearest Player", function()
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local closest, closestDist = nil, 9999
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= player and p.Character then
            local pRoot = p.Character:FindFirstChild("HumanoidRootPart")
            if pRoot then
                local dist = (root.Position - pRoot.Position).Magnitude
                if dist < closestDist then closest = pRoot closestDist = dist end
            end
        end
    end
    if closest then root.CFrame = CFrame.new(closest.Position + Vector3.new(3,0,0)) end
end)

