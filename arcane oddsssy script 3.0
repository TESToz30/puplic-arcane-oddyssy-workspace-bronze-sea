UI.Label(SettingsPage, "── Cleanup ──")
UI.Button(SettingsPage, "Disable All Features", function()
    AutoFarm.Enabled = false
    AutoFarm.AutoCollect = false
    KillAura.Enabled = false
    ESP.Enabled = false
    ESP.Players = false
    ESP.Mobs    = false
    ESP.Items   = false
    for k in pairs(ESP.Chests) do ESP.Chests[k] = false end
    ESP.Clear()
    Features.SetNoclip(false)
    Features.SetSpeed(16)
    Features.SetJump(50)
    Features.SetInfiniteStamina(false)
    Performance.SetBrightness(100)
    for _, c in pairs(Connections) do
        if c and c.Connected then c:Disconnect() end
    end
    Connections = {}
    print("[AO Hub] All features disabled.")
end)

UI.Label(SettingsPage, "── Shutdown ──")
UI.Button(SettingsPage, "🛑  CLOSE SCRIPT  (Ends Everything)", function()
    -- Step 1: Stop all feature loops
    pcall(function() AutoFarm.Enabled = false end)
    pcall(function() AutoFarm.AutoCollect = false end)
    pcall(function() KillAura.Enabled = false end)
    pcall(function() Fly.Stop() end)

    -- Step 2: Stop all ESP and clear highlights/labels
    pcall(function()
        ESP.Enabled = false
        ESP.Players = false
        ESP.Mobs    = false
        ESP.Items   = false
        for k in pairs(ESP.Chests) do ESP.Chests[k] = false end
        ESP.Clear()
    end)

    -- Step 3: Reset player state
    pcall(function() Features.SetNoclip(false) end)
    pcall(function() Features.SetSpeed(16) end)
    pcall(function() Features.SetJump(50) end)
    pcall(function() Features.SetInfiniteStamina(false) end)

    -- Step 4: Restore character physics
    pcall(function()
        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        if root then
            root.Anchored = false
            if root:FindFirstChild("_FlyVel")  then root._FlyVel:Destroy()  end
            if root:FindFirstChild("_FlyGyro") then root._FlyGyro:Destroy() end
        end
        if hum then
            hum.PlatformStand = false
            hum.WalkSpeed = 16
            hum.JumpPower = 50
        end
    end)

    -- Step 5: Restore lighting
    pcall(function() Performance.SetBrightness(100) end)
    pcall(function() Performance.SetFogDensity(0) end)
    pcall(function() Performance.DisableParticles(false) end)
    pcall(function() Performance.DisableSounds(false) end)
    pcall(function() Performance.DisableTerrainDetails(false) end)
    pcall(function() Performance.DisableInsanityEffects(false) end)

    -- Step 6: Disconnect every RunService/UserInput connection
    for _, c in pairs(Connections) do
        pcall(function()
            if c and c.Connected then c:Disconnect() end
        end)
    end
    Connections = {}

    -- Step 7: Remove the HitMultiplier hook if it was installed
    pcall(function() RemoveHook() end)

    -- Step 8: Destroy the entire GUI — this removes all UI elements permanently
    pcall(function() gui:Destroy() end)

    print("[AO Hub] Script shut down completely.")
end)

UI.Label(SettingsPage, "── Verified Paths ──")
