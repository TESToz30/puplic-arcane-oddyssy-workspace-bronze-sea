--// =========================
--// TAB SYSTEM
--// =========================
local pages = {}
local tabBtns = {}

local function CreatePage(name)
    local page = Instance.new("ScrollingFrame")
    page.Size = UDim2.new(1, 0, 1, 0)
    page.BackgroundTransparency = 1
    page.Visible = false
    page.ScrollBarThickness = 3
    page.ScrollBarImageColor3 = Color3.fromRGB(100, 140, 255)
    page.CanvasSize = UDim2.new(0, 0, 0, 0)
    page.AutomaticCanvasSize = Enum.AutomaticSize.Y
    page.Parent = content

    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, 6)
    layout.Parent = page

    local padding = Instance.new("UIPadding")
    padding.PaddingLeft = UDim.new(0, 8)
    padding.PaddingRight = UDim.new(0, 8)
    padding.PaddingTop = UDim.new(0, 8)
    padding.Parent = page

    pages[name] = page
    return page
end

local function SwitchTab(name)
    for n, page in pairs(pages) do
        page.Visible = (n == name)
    end
    for n, btn in pairs(tabBtns) do
        if n == name then
            btn.BackgroundColor3 = Color3.fromRGB(60, 100, 200)
            btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        else
            btn.BackgroundColor3 = Color3.fromRGB(30, 30, 44)
            btn.TextColor3 = Color3.fromRGB(160, 160, 180)
        end
    end
end

local function CreateTab(name)
    local tab = Instance.new("TextButton")
    tab.Size = UDim2.new(0, 72, 0, 26)
    tab.BackgroundColor3 = Color3.fromRGB(30, 30, 44)
    tab.Text = name
    tab.TextColor3 = Color3.fromRGB(160, 160, 180)
    tab.Font = Enum.Font.GothamBold
    tab.TextSize = 11
    tab.Parent = tabBar
    Instance.new("UICorner", tab).CornerRadius = UDim.new(0, 5)

    local page = CreatePage(name)
    tabBtns[name] = tab
    tab.MouseButton1Click:Connect(function() SwitchTab(name) end)
    return page
end

--// =========================
--// UI ELEMENTS API
--// =========================
local UI = {}

function UI.Label(page, text)
    local l = Instance.new("TextLabel")
    l.Size = UDim2.new(1, 0, 0, 20)
    l.BackgroundTransparency = 1
    l.Text = "  " .. text
    l.TextColor3 = Color3.fromRGB(100, 130, 200)
    l.Font = Enum.Font.GothamBold
    l.TextSize = 11
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.Parent = page
    return l
end

function UI.Button(page, text, callback)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, 0, 0, 34)
    b.BackgroundColor3 = Color3.fromRGB(35, 45, 75)
    b.Text = text
    b.TextColor3 = Color3.new(1,1,1)
    b.Font = Enum.Font.Gotham
    b.TextSize = 12
    b.Parent = page
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(60, 90, 160)
    stroke.Thickness = 1
    stroke.Parent = b

    b.MouseEnter:Connect(function()
        TweenService:Create(b, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(50, 70, 130)}):Play()
    end)
    b.MouseLeave:Connect(function()
        TweenService:Create(b, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(35, 45, 75)}):Play()
    end)
    b.MouseButton1Click:Connect(callback)
    return b
end

function UI.Toggle(page, text, default, callback)
    local state = default or false
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, 0, 0, 34)
    b.BackgroundColor3 = state and Color3.fromRGB(30, 80, 50) or Color3.fromRGB(60, 30, 30)
    b.Text = text .. "  [" .. (state and "ON" or "OFF") .. "]"
    b.TextColor3 = Color3.new(1,1,1)
    b.Font = Enum.Font.Gotham
    b.TextSize = 12
    b.Parent = page
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)

    local stroke = Instance.new("UIStroke")
    stroke.Color = state and Color3.fromRGB(60, 160, 90) or Color3.fromRGB(160, 60, 60)
    stroke.Thickness = 1
    stroke.Parent = b

    b.MouseButton1Click:Connect(function()
        state = not state
        b.Text = text .. "  [" .. (state and "ON" or "OFF") .. "]"
        TweenService:Create(b, TweenInfo.new(0.15), {
            BackgroundColor3 = state and Color3.fromRGB(30, 80, 50) or Color3.fromRGB(60, 30, 30)
        }):Play()
        stroke.Color = state and Color3.fromRGB(60, 160, 90) or Color3.fromRGB(160, 60, 60)
        callback(state)
    end)
    return b, function() return state end
end

function UI.Slider(page, text, min, max, default, callback)
    local val = default or min
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, 0, 0, 50)
    frame.BackgroundColor3 = Color3.fromRGB(28, 28, 40)
    frame.Parent = page
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 6)

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -10, 0, 22)
    label.Position = UDim2.new(0, 8, 0, 2)
    label.BackgroundTransparency = 1
    label.Text = text .. ": " .. tostring(val)
    label.TextColor3 = Color3.new(1,1,1)
    label.Font = Enum.Font.Gotham
    label.TextSize = 12
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = frame

    local track = Instance.new("Frame")
    track.Size = UDim2.new(1, -16, 0, 6)
    track.Position = UDim2.new(0, 8, 0, 32)
    track.BackgroundColor3 = Color3.fromRGB(40, 40, 60)
    track.Parent = frame
    Instance.new("UICorner", track).CornerRadius = UDim.new(0, 3)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new((val - min) / (max - min), 0, 1, 0)
    fill.BackgroundColor3 = Color3.fromRGB(80, 130, 255)
    fill.Parent = track
    Instance.new("UICorner", fill).CornerRadius = UDim.new(0, 3)

    local draggingSlider = false
    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then draggingSlider = true end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then draggingSlider = false end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if draggingSlider and input.UserInputType == Enum.UserInputType.MouseMovement then
            local rel = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
            val = math.floor(min + (max - min) * rel)
            fill.Size = UDim2.new(rel, 0, 1, 0)
            label.Text = text .. ": " .. tostring(val)
            callback(val)
        end
    end)
    return frame
end

--// =========================
--// CONNECTION CLEANUP
--// =========================
local Connections = {}
local function AddConn(c) table.insert(Connections, c) return c end

--// =========================
--// MULTI-HIT DAMAGE MULTIPLIER
--// =========================
local MultiHit = {
    Multiplier = 4,
    DelayMs = 50,
    LastTarget = nil,
    IsHitting = false
}

local function GetNearestNPC()
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    local closest, closestDist = nil, 100
    for _, npcFolder in pairs(NPCsFolder:GetChildren()) do
        local npcChar = npcFolder:FindFirstChild(npcFolder.Name)
        if npcChar then
            local npcHum = npcChar:FindFirstChildOfClass("Humanoid")
            local npcRoot = npcChar:FindFirstChild("HumanoidRootPart")
            if npcHum and npcHum.Health > 0 and npcRoot then
                local dist = (root.Position - npcRoot.Position).Magnitude
                if dist < closestDist then
                    closest = npcChar
                    closestDist = dist
                end
            end
        end
    end
    return closest
end

function MultiHit.HitNearest()
    if MultiHit.IsHitting then
        print("[AO Hub] Already hitting! Wait for combo to finish.")
        return
    end
    local target = GetNearestNPC()
    if not target then
        print("[AO Hub] No NPCs found nearby!")
        return
    end
    local tRoot = target:FindFirstChild("HumanoidRootPart")
    if not tRoot then return end
    MultiHit.IsHitting = true
    MultiHit.LastTarget = target
    print("[AO Hub] 🔥 " .. MultiHit.Multiplier .. "x damage combo on " .. target.Name .. "!")
    for hitNum = 1, MultiHit.Multiplier do
        task.spawn(function()
            task.wait((hitNum - 1) * (MultiHit.DelayMs / 1000))
            pcall(function()
                if DealAttackDamage then
                    DealAttackDamage:FireServer(target)
                    print("[AO Hub] Hit " .. hitNum .. "/" .. MultiHit.Multiplier)
                end
            end)
        end)
    end
    task.spawn(function()
        task.wait((MultiHit.Multiplier) * (MultiHit.DelayMs / 1000) + 0.1)
        MultiHit.IsHitting = false
        print("[AO Hub] ✅ Combo complete! (" .. MultiHit.Multiplier .. " hits)")
    end)
end

--// =========================
--// =========================
--// ESP MODULE (v2)
--//
--// Features:
--//   - Distance filter (0 = unlimited)
--//   - Player ESP with BillboardGui showing Name / HP / Awakening
--//   - Mob ESP (Workspace.Enemies — works across all seas)
--//   - Item ESP  (scans ALL of Workspace for loose item parts by name)
--//     Includes: Moly + any item whose name matches the scan keywords
--//   - Chest ESP — scans Workspace.Map recursively for all chest types:
--//       Treasure Chest, Rare Chest, Uncommon Chest, Legendary Chest,
--//       Sunken Chest, Dark Chest, Nimbus Chest, Enchanted Chest, Crate
--//   - All ESP types are togglable independently
--//   - Auto-refresh every 2s while any ESP is active
--// =========================

local ESP = {
    Enabled        = false,
    Players        = false,
    Mobs           = false,
    Items          = false,
    Chests         = {
        Treasure   = false,
        Rare       = false,
        Uncommon   = false,
        Legendary  = false,
        Sunken     = false,
        Dark       = false,
        Nimbus     = false,
        Enchanted  = false,
        Crate      = false,
    },
    MaxDistance    = 0,       -- 0 = unlimited
    Highlights     = {},
    Labels         = {},      -- BillboardGuis for player info
}

-- Chest name patterns → { display name, color }
