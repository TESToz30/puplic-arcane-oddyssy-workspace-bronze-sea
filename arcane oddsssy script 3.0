-- Item name patterns: live-scan of ALL Workspace for dropped BaseParts by name.
-- Moly    = dropped BasePart "Moly"          — live scan only (no static spawn point)
-- Reagent = dropped BasePart "Reagent"       — live scan only
-- Herb    = ALSO has a static path (see STATIC_ITEM_PATHS) but caught here as fallback
local ITEM_SCAN_PATTERNS = {
    "moly",
    "herb",
    "reagent",
    "mushroom",
    "ingredient",
    "galleon",
    "drop",
    "loot",
    "collectible",
}

-- Static confirmed paths from workspace scan — these are REAL object locations,
-- not spawn zones. Each entry returns a folder/part that is always present.
--
-- Herb:   Workspace.Map.Harvest Island.Herbs  (folder containing Herb parts)
--         Multiple Herb BaseParts confirmed at size 0.6 x 1.9 x 0.6
--         Also present as HerbSpawn zones on Thorin Refuge, Blackreach, Ierochos
--         but live Herb parts only confirmed under Harvest Island.Herbs
--
-- Mushroom: Only MushroomSpawn zones found — no live Mushroom parts in scan.
--           Kept as live-scan only via ITEM_SCAN_PATTERNS "mushroom".
--
-- Moly:   Not a static object — spawns as a dropped BasePart in the world.
--         Caught by live scan via ITEM_SCAN_PATTERNS "moly".
--
-- Reagent: Not a static object — dropped item only.
--          Caught by live scan via ITEM_SCAN_PATTERNS "reagent".

local STATIC_ITEM_PATHS = {
    -- Harvest Island: Workspace.Map.Harvest Island.Herbs — confirmed live Herb parts
    {
        get = function()
            local island = MapFolder:FindFirstChild("Harvest Island")
            if not island then return nil end
            return island:FindFirstChild("Herbs")  -- folder of Herb BaseParts
        end,
        label = "Herb (Harvest Island)",
        -- Returns the folder; ESP code walks its children for individual Herb parts
        isFolder = true,
    },
    -- HerbSpawn zones — teleport targets for item farm (not ESP highlights, used by farm)
    -- Thorin Refuge HerbSpawns
    {
        get = function()
            local island = MapFolder:FindFirstChild("Thorin's Refuge")
            if not island then return nil end
            local hs = island:FindFirstChild("HerbSpawns")
            return hs and hs:FindFirstChild("HerbSpawn")
        end,
        label = "Herb Spawn (Thorin's Refuge)",
        isFolder = false,
    },
    -- Blackreach Island HerbSpawns
    {
        get = function()
            local island = MapFolder:FindFirstChild("Blackreach Island")
            if not island then return nil end
            local hs = island:FindFirstChild("HerbSpawns")
            return hs and hs:FindFirstChild("HerbSpawn")
        end,
        label = "Herb Spawn (Blackreach Island)",
        isFolder = false,
    },
    -- Ierochos HerbSpawns
    {
        get = function()
            local island = MapFolder:FindFirstChild("Ierochos")
            if not island then return nil end
            local hs = island:FindFirstChild("HerbSpawns")
            return hs and hs:FindFirstChild("HerbSpawn")
        end,
        label = "Herb Spawn (Ierochos)",
        isFolder = false,
    },
}

-- Farm teleport target list — used by the Item Farm dropdown in the Farm tab
-- Each entry: { label, getFunc returning a BasePart to teleport near }
local FARM_TARGETS = {
    {
        label = "Herb — Harvest Island",
        get = function()
            local island = MapFolder:FindFirstChild("Harvest Island")
            if not island then return nil end
            local herbs = island:FindFirstChild("Herbs")
            return herbs and herbs:FindFirstChildWhichIsA("BasePart")
        end,
    },
    {
        label = "Herb Spawn — Thorin's Refuge",
        get = function()
            local island = MapFolder:FindFirstChild("Thorin's Refuge")
            if not island then return nil end
            local hs = island:FindFirstChild("HerbSpawns")
            return hs and hs:FindFirstChild("HerbSpawn")
        end,
    },
    {
        label = "Herb Spawn — Blackreach Island",
        get = function()
            local island = MapFolder:FindFirstChild("Blackreach Island")
            if not island then return nil end
            local hs = island:FindFirstChild("HerbSpawns")
            return hs and hs:FindFirstChild("HerbSpawn")
        end,
    },
    {
        label = "Herb Spawn — Ierochos",
        get = function()
            local island = MapFolder:FindFirstChild("Ierochos")
            if not island then return nil end
            local hs = island:FindFirstChild("HerbSpawns")
            return hs and hs:FindFirstChild("HerbSpawn")
        end,
    },
    {
        label = "Moly — Live Scan (nearest)",
        get = function()
            -- Moly is dropped in the world; find the nearest one
            local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
            local best, bestDist = nil, math.huge
            for _, obj in pairs(Workspace:GetDescendants()) do
                if obj:IsA("BasePart") and obj.Name:lower() == "moly" then
                    if root then
                        local d = (root.Position - obj.Position).Magnitude
                        if d < bestDist then best = obj bestDist = d end
                    else
                        best = obj break
                    end
                end
            end
            return best
        end,
    },
    {
        label = "Reagent — Live Scan (nearest)",
        get = function()
            local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
            local best, bestDist = nil, math.huge
            for _, obj in pairs(Workspace:GetDescendants()) do
                if obj:IsA("BasePart") and obj.Name:lower():find("reagent") then
                    if root then
                        local d = (root.Position - obj.Position).Magnitude
                        if d < bestDist then best = obj bestDist = d end
                    else
                        best = obj break
                    end
                end
            end
            return best
        end,
    },
    {
        label = "Mushroom Spawn — Harvest Island",
        get = function()
            local island = MapFolder:FindFirstChild("Harvest Island")
            if not island then return nil end
            local hs = island:FindFirstChild("HerbSpawns")
            return hs and hs:FindFirstChild("MushroomSpawn")
        end,
    },
    {
        label = "Mushroom Spawn — Thorin's Refuge",
        get = function()
            local island = MapFolder:FindFirstChild("Thorin's Refuge")
            if not island then return nil end
            local hs = island:FindFirstChild("HerbSpawns")
            return hs and hs:FindFirstChild("MushroomSpawn")
        end,
    },
    {
        label = "Fruit — Harvest Island",
        get = function()
            local island = MapFolder:FindFirstChild("Harvest Island")
            if not island then return nil end
            local fruits = island:FindFirstChild("Fruits")
            return fruits and fruits:FindFirstChildWhichIsA("BasePart")
        end,
    },
    {
        label = "Coconut — Harvest Island",
        get = function()
            local island = MapFolder:FindFirstChild("Harvest Island")
            if not island then return nil end
            local coconuts = island:FindFirstChild("Coconuts")
            return coconuts and coconuts:FindFirstChildWhichIsA("BasePart")
        end,
    },
}

-- ── Helpers ──────────────────────────────────────────────────────────────

local function GetPlayerRoot()
    local char = player.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function InRange(part)
    if ESP.MaxDistance <= 0 then return true end
    local root = GetPlayerRoot()
    if not root then return true end
    return (root.Position - part.Position).Magnitude <= ESP.MaxDistance
end

local function PlaceHighlight(instance, color, fillT)
    local existing = instance:FindFirstChild("_ESP_H")
    if existing then existing:Destroy() end
    local h = Instance.new("Highlight")
    h.Name = "_ESP_H"
    h.OutlineColor = color
    h.FillColor = color
    h.FillTransparency = fillT or 0.7
    h.OutlineTransparency = 0
    h.Adornee = instance
    h.Parent = instance
    table.insert(ESP.Highlights, h)
    return h
end

-- Creates a BillboardGui label attached to a BasePart
local function PlaceLabel(part, lines, textColor)
    local existing = part:FindFirstChild("_ESP_L")
    if existing then existing:Destroy() end

    local bb = Instance.new("BillboardGui")
    bb.Name = "_ESP_L"
    bb.Adornee = part
    bb.AlwaysOnTop = true
    bb.Size = UDim2.new(0, 160, 0, 60)
    bb.StudsOffset = Vector3.new(0, 3, 0)
    bb.Parent = part

    for i, line in ipairs(lines) do
        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(1, 0, 0, 18)
        lbl.Position = UDim2.new(0, 0, 0, (i-1)*18)
        lbl.BackgroundTransparency = 1
        lbl.Text = line
        lbl.TextColor3 = textColor or Color3.new(1,1,1)
        lbl.TextStrokeTransparency = 0.4
        lbl.Font = Enum.Font.GothamBold
        lbl.TextSize = 12
        lbl.Parent = bb
    end

    table.insert(ESP.Labels, bb)
    return bb
end

-- ── Clear ────────────────────────────────────────────────────────────────

function ESP.Clear()
    for _, h in pairs(ESP.Highlights) do
        if h and h.Parent then h:Destroy() end
    end
    for _, l in pairs(ESP.Labels) do
        if l and l.Parent then l:Destroy() end
    end
    ESP.Highlights = {}
    ESP.Labels     = {}
end

-- ── Scan helpers ─────────────────────────────────────────────────────────

-- Recursively scan a folder for chest objects matching a pattern
-- Returns the PARENT model/folder, not the raw part, to highlight correctly
local function ScanForChests(root, pattern)
    local found = {}
    local seen  = {}
    for _, obj in pairs(root:GetDescendants()) do
        if obj:IsA("BasePart") or obj:IsA("Model") then
            local n = obj.Name:lower()
            if n:find(pattern) then
                -- Walk up to find the top-level container (direct child of a chest folder)
                local target = obj
                if obj:IsA("BasePart") then
                    -- Use the parent model if it exists
                    local par = obj.Parent
                    if par and (par:IsA("Model") or par:IsA("Folder")) then
                        target = par
                    end
                end
                if not seen[target] then
                    seen[target] = true
                    table.insert(found, target)
                end
            end
        end
    end
    return found
end

-- Scan ALL of Workspace for loose item parts by name pattern
-- Works regardless of sea — no hardcoded folder paths
local function ScanWorkspaceForItems(patterns)
    local found = {}
    local seen  = {}
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") and not seen[obj] then
            local n = obj.Name:lower()
            for _, pat in ipairs(patterns) do
                if n:find(pat) then
                    seen[obj] = true
                    table.insert(found, obj)
                    break
                end
            end
        end
    end
    return found
end

-- ── Update ───────────────────────────────────────────────────────────────

function ESP.Update()
    ESP.Clear()
    if not ESP.Enabled then return end

    -- ── PLAYER ESP ──
    if ESP.Players then
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= player and p.Character then
                local char = p.Character
                local root = char:FindFirstChild("HumanoidRootPart")
                local hum  = char:FindFirstChildOfClass("Humanoid")
                if root and InRange(root) then
                    PlaceHighlight(char, Color3.fromRGB(255, 80, 80), 0.6)

                    -- Build info lines
                    local name = p.DisplayName ~= "" and p.DisplayName or p.Name
                    local hp   = "HP: ?"
                    local awk  = "Awakening: ?"

                    if hum then
                        local maxHp = math.floor(hum.MaxHealth)
                        local curHp = math.floor(hum.Health)
                        hp = "HP: " .. curHp .. " / " .. maxHp
                    end

                    -- Scan for Awakening value — stored in various locations depending on game version
                    pcall(function()
                        local pData = p:FindFirstChild("Data") or p:FindFirstChild("PlayerData")
                        if pData then
                            local aw = pData:FindFirstChild("Awakening") or pData:FindFirstChild("Awoken")
                            if aw then awk = "Awakening: " .. tostring(aw.Value) end
                        end
                        -- Also check character attributes
                        local awAttr = char:GetAttribute("Awakening") or char:GetAttribute("Awoken")
                        if awAttr ~= nil then awk = "Awakening: " .. tostring(awAttr) end
                    end)

                    PlaceLabel(root, { "👤 " .. name, hp, awk }, Color3.fromRGB(255, 160, 160))
                end
            end
        end
    end

    -- ── MOB ESP ──
    -- Scans Workspace.Enemies — this folder exists in all seas (Bronze, Nimbus, etc.)
    if ESP.Mobs then
        for _, enemy in pairs(EnemiesFolder:GetChildren()) do
            local root = enemy:FindFirstChild("HumanoidRootPart")
            local hum  = enemy:FindFirstChildOfClass("Humanoid")
            if root and InRange(root) then
                PlaceHighlight(enemy, Color3.fromRGB(200, 80, 255), 0.65)
                local hp = hum and (math.floor(hum.Health) .. "/" .. math.floor(hum.MaxHealth)) or "?"
                PlaceLabel(root, { "⚔ " .. enemy.Name, "HP: " .. hp }, Color3.fromRGB(220, 150, 255))
            end
        end
    end

    -- ── ITEM ESP (Moly + all items) ──
    -- 1) Live scan: dropped BaseParts across all of Workspace
    -- 2) Static scan: confirmed permanent paths (Herb at QuestObjects.Items.Herb)
    if ESP.Items then
        local seen = {}
        local items = ScanWorkspaceForItems(ITEM_SCAN_PATTERNS)
        for _, obj in pairs(items) do
            if InRange(obj) and not seen[obj] then
                seen[obj] = true
                PlaceHighlight(obj, Color3.fromRGB(80, 255, 160), 0.4)
                PlaceLabel(obj, { "💎 " .. obj.Name }, Color3.fromRGB(80, 255, 160))
            end
        end
        -- Static paths (confirmed from workspace scan)
        -- isFolder=true entries: walk their children for individual BaseParts
        for _, entry in ipairs(STATIC_ITEM_PATHS) do
            if not entry.isFolder then
                local obj = entry.get()
                if obj and not seen[obj] then
                    local refPart = obj:IsA("BasePart") and obj
                        or obj:FindFirstChildWhichIsA("BasePart", true)
                    if refPart and InRange(refPart) then
                        seen[obj] = true
                        PlaceHighlight(obj, Color3.fromRGB(80, 255, 160), 0.4)
                        PlaceLabel(refPart, {"🌿 "..entry.label}, Color3.fromRGB(80, 255, 160))
                    end
                end
            else
                -- Folder: highlight each child BasePart individually
                local folder = entry.get()
                if folder then
                    for _, child in pairs(folder:GetChildren()) do
                        if child:IsA("BasePart") and not seen[child] and InRange(child) then
                            seen[child] = true
                            PlaceHighlight(child, Color3.fromRGB(80, 255, 160), 0.4)
                            PlaceLabel(child, {"🌿 "..entry.label}, Color3.fromRGB(80, 255, 160))
                        end
                    end
                end
            end
        end
    end

    -- ── CHEST ESP ──
    -- Scans Workspace.Map recursively — works for all seas
    -- Each chest type is individually togglable
    local anyChest = false
    for _, ct in pairs(ESP.Chests) do if ct then anyChest = true break end end

    if anyChest then
        for _, chestType in ipairs(CHEST_TYPES) do
            if ESP.Chests[chestType.key] then
                local found = ScanForChests(MapFolder, chestType.pattern)
                for _, obj in pairs(found) do
                    local refPart = obj:IsA("BasePart") and obj
                        or obj:FindFirstChildWhichIsA("BasePart", true)
                    if refPart and InRange(refPart) then
                        PlaceHighlight(obj, chestType.color, 0.45)
                        PlaceLabel(refPart, { "📦 " .. chestType.label }, chestType.color)
                    end
                end
            end
        end
    end
end

-- Auto-refresh every ~2s while ESP is active
local espTick = 0
AddConn(RunService.Stepped:Connect(function()
    espTick += 1
    if espTick >= 120 then
        espTick = 0
        local anyActive = ESP.Enabled and (
            ESP.Players or ESP.Mobs or ESP.Items or
            (function()
                for _, v in pairs(ESP.Chests) do if v then return true end end
                return false
            end)()
        )
        if anyActive then ESP.Update() end
    end
end))

--// =========================
--// KILL AURA
--// =========================
local KillAura = {Enabled=false, Range=20, Cooldown=0.5, LastHit=0}

local function GetNearestEnemy()
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    local closest, closestDist = nil, KillAura.Range
    for _, enemy in pairs(EnemiesFolder:GetChildren()) do
        local hum = enemy:FindFirstChildOfClass("Humanoid")
        local eRoot = enemy:FindFirstChild("HumanoidRootPart")
        if hum and hum.Health > 0 and eRoot then
            local dist = (root.Position - eRoot.Position).Magnitude
            if dist < closestDist then
                closest = enemy
                closestDist = dist
            end
        end
    end
    return closest
end

AddConn(RunService.Heartbeat:Connect(function()
    if not KillAura.Enabled then return end
    local now = tick()
    if now - KillAura.LastHit < KillAura.Cooldown then return end
    KillAura.LastHit = now
    local target = GetNearestEnemy()
    if target then
        local tRoot = target:FindFirstChild("HumanoidRootPart")
        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if tRoot and root then
            root.CFrame = CFrame.new(tRoot.Position + Vector3.new(0, 0, 3))
        end
    end
end))

--// =========================
--// AUTO FARM
--// =========================
local AutoFarm = {Enabled=false, AutoCollect=false, CollectRange=30}

AddConn(RunService.Heartbeat:Connect(function()
    if not AutoFarm.Enabled then return end
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not root or not hum then return end
    local closest, closestDist = nil, 300
    for _, enemy in pairs(EnemiesFolder:GetChildren()) do
        local eHum = enemy:FindFirstChildOfClass("Humanoid")
        local eRoot = enemy:FindFirstChild("HumanoidRootPart")
        if eHum and eHum.Health > 0 and eRoot then
            local dist = (root.Position - eRoot.Position).Magnitude
            if dist < closestDist then closest = enemy closestDist = dist end
        end
    end
    if closest then
        local eRoot = closest:FindFirstChild("HumanoidRootPart")
        if eRoot and closestDist > 8 then
            hum:MoveTo(eRoot.Position)
        end
    end
end))

AddConn(RunService.Heartbeat:Connect(function()
    if not AutoFarm.AutoCollect then return end
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    for _, obj in pairs(MapFolder:GetDescendants()) do
        if obj:IsA("BasePart") then
            local n = obj.Name:lower()
            if n == "chest" or n:find("crate") or n:find("treasure") then
                local dist = (root.Position - obj.Position).Magnitude
                if dist < AutoFarm.CollectRange then
                    pcall(function() OpenChest:FireServer(obj) end)
                end
            end
        end
    end
end))

--// =========================
--// PLAYER FEATURES
--// =========================
local noclipConn
local speedLoop
local currentSpeed = 16
local infStamLoop
local Features = {}

function Features.SetSpeed(v)
    currentSpeed = v
    if not speedLoop then
        speedLoop = RunService.Heartbeat:Connect(function()
            local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
            if hum then hum.WalkSpeed = currentSpeed end
        end)
        AddConn(speedLoop)
    end
end

function Features.SetJump(v)
    local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
    if hum then hum.JumpPower = v end
end

function Features.SetNoclip(state)
    if noclipConn then noclipConn:Disconnect() end
    if state then
        noclipConn = RunService.Stepped:Connect(function()
            local char = player.Character
            if char then
                for _, p in pairs(char:GetDescendants()) do
                    if p:IsA("BasePart") then p.CanCollide = false end
                end
            end
        end)
        AddConn(noclipConn)
    end
end

function Features.SetInfiniteStamina(state)
    if infStamLoop then infStamLoop:Disconnect() end
    if state then
        infStamLoop = RunService.Heartbeat:Connect(function()
            pcall(function()
                ExhaustionToggle:FireServer(false)
                local char = player.Character
                if char then
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    if hum and hum:FindFirstChild("Stamina") then
                        hum.Stamina.Value = 100
                    end
                end
            end)
        end)
        AddConn(infStamLoop)
    end
end

function Features.TeleportToMouse()
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if root then
        root.CFrame = CFrame.new(player:GetMouse().Hit.Position + Vector3.new(0,3,0))
    end
end

function Features.TeleportToIsland(folderName)
    local island = MapFolder:FindFirstChild(folderName)
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not root or not hum then return end
    if not island then
        warn("[AO Hub] Island folder not found: " .. folderName)
        return
    end
    local part = island:FindFirstChildWhichIsA("BasePart", true)
    if not part then
        warn("[AO Hub] No BasePart found in island: " .. folderName)
        return
    end
    local targetXZ = Vector3.new(part.Position.X, 0, part.Position.Z)
    if folderName == "Harvest Island" then
        targetXZ = targetXZ + Vector3.new(300, 0, 0)
    end
    local holdY = part.Position.Y + 500
    root.CFrame = CFrame.new(Vector3.new(targetXZ.X, holdY, targetXZ.Z))
    root.Anchored = true
    local loadLabel = Instance.new("TextLabel")
    loadLabel.Size = UDim2.new(0, 300, 0, 40)
    loadLabel.Position = UDim2.new(0.5, -150, 0.15, 0)
    loadLabel.BackgroundColor3 = Color3.fromRGB(15, 15, 22)
    loadLabel.BackgroundTransparency = 0.2
    loadLabel.TextColor3 = Color3.fromRGB(130, 180, 255)
    loadLabel.Font = Enum.Font.GothamBold
    loadLabel.TextSize = 14
    loadLabel.Text = "⏳ Waiting for " .. folderName .. " to load..."
    loadLabel.ZIndex = 10
    Instance.new("UICorner", loadLabel).CornerRadius = UDim.new(0, 8)
    loadLabel.Parent = gui
    task.spawn(function()
        local mandatory = 12
        local elapsed = 0
        -- Keep player frozen and update label during the mandatory wait
        while elapsed < mandatory do
            task.wait(0.5)
            elapsed += 0.5
            if root and root.Parent then
                root.CFrame = CFrame.new(Vector3.new(targetXZ.X, holdY, targetXZ.Z))
            end
            local remaining = math.ceil(mandatory - elapsed)
            local dots = string.rep(".", (math.floor(elapsed) % 3) + 1)
            loadLabel.Text = "⏳ Loading " .. folderName .. dots .. " (" .. remaining .. "s)"
        end
        -- After mandatory wait, raycast to find ground
        loadLabel.Text = "✅ " .. folderName .. " loaded! Landing..."
        local rayOrigin = Vector3.new(targetXZ.X, holdY, targetXZ.Z)
        local rayDir = Vector3.new(0, -600, 0)
        local rayParams = RaycastParams.new()
        rayParams.FilterDescendantsInstances = {char}
        rayParams.FilterType = Enum.RaycastFilterType.Exclude
        local result = Workspace:Raycast(rayOrigin, rayDir, rayParams)
        root.Anchored = false
        if result and result.Instance then
            root.CFrame = CFrame.new(Vector3.new(targetXZ.X, result.Position.Y + 5, targetXZ.Z))
        else
            root.CFrame = CFrame.new(Vector3.new(targetXZ.X, part.Position.Y + 20, targetXZ.Z))
        end
        task.wait(1.5)
        loadLabel:Destroy()
    end)
end

function Features.TeleportToNPC(name)
    local npcFolder = NPCsFolder:FindFirstChild(name)
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    if npcFolder then
        local npcChar = npcFolder:FindFirstChild(name)
        local npcRoot = npcChar and npcChar:FindFirstChild("HumanoidRootPart")
        if npcRoot then
            root.CFrame = CFrame.new(npcRoot.Position + Vector3.new(3, 0, 0))
            return
        end
    end
    warn("[AO Hub] NPC not found: " .. name)
end

function Features.TeleportToNearestEnemy()
    local target = GetNearestEnemy()
    if target then
        local tRoot = target:FindFirstChild("HumanoidRootPart")
        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if tRoot and root then
            root.CFrame = CFrame.new(tRoot.Position + Vector3.new(0, 0, 4))
        end
    end
end

--// =========================
--// FLY SYSTEM
--// =========================
local Fly = {
    Enabled   = false,
    Speed     = 50,       -- studs/s, configurable 0-8000
    Keybind   = Enum.KeyCode.F,  -- default keybind, player can change
    _conn     = nil,
    _bodyVel  = nil,
    _bodyGyro = nil,
}

function Fly.Start()
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum  = char and char:FindFirstChildOfClass("Humanoid")
    if not root or not hum then return end

    hum.PlatformStand = true

    -- Remove old movers if present
    if root:FindFirstChild("_FlyVel")  then root:FindFirstChild("_FlyVel"):Destroy()  end
    if root:FindFirstChild("_FlyGyro") then root:FindFirstChild("_FlyGyro"):Destroy() end

    local bv = Instance.new("BodyVelocity")
    bv.Name = "_FlyVel"
    bv.Velocity = Vector3.zero
    bv.MaxForce = Vector3.new(1e5, 1e5, 1e5)
    bv.Parent = root
    Fly._bodyVel = bv

    local bg = Instance.new("BodyGyro")
    bg.Name = "_FlyGyro"
    bg.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
    bg.D = 100
    bg.CFrame = root.CFrame
    bg.Parent = root
    Fly._bodyGyro = bg

    if Fly._conn then Fly._conn:Disconnect() end
    Fly._conn = RunService.Heartbeat:Connect(function()
        local c = player.Character
        local r = c and c:FindFirstChild("HumanoidRootPart")
        if not r or not Fly.Enabled then
            Fly.Stop()
            return
        end
        local cam = Workspace.CurrentCamera
        local dir = Vector3.zero
        local spd = Fly.Speed

        -- WASD + camera direction
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then
            dir = dir + cam.CFrame.LookVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then
            dir = dir - cam.CFrame.LookVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then
            dir = dir - cam.CFrame.RightVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then
            dir = dir + cam.CFrame.RightVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
            dir = dir + Vector3.new(0, 1, 0)
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or
           UserInputService:IsKeyDown(Enum.KeyCode.C) then
            dir = dir - Vector3.new(0, 1, 0)
        end

        if dir.Magnitude > 0 then
            dir = dir.Unit
        end

        if Fly._bodyVel and Fly._bodyVel.Parent then
            Fly._bodyVel.Velocity = dir * spd
        end
        if Fly._bodyGyro and Fly._bodyGyro.Parent then
            Fly._bodyGyro.CFrame = cam.CFrame
        end
    end)
    AddConn(Fly._conn)
end

function Fly.Stop()
    Fly.Enabled = false
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum  = char and char:FindFirstChildOfClass("Humanoid")
    if root then
        if root:FindFirstChild("_FlyVel")  then root:FindFirstChild("_FlyVel"):Destroy()  end
        if root:FindFirstChild("_FlyGyro") then root:FindFirstChild("_FlyGyro"):Destroy() end
    end
    if hum then hum.PlatformStand = false end
    if Fly._conn then Fly._conn:Disconnect() Fly._conn = nil end
end

function Fly.Toggle()
    Fly.Enabled = not Fly.Enabled
    if Fly.Enabled then Fly.Start() else Fly.Stop() end
end

-- Listen for keybind
AddConn(UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.KeyCode == Fly.Keybind then
        Fly.Toggle()
    end
end))

--// =========================
--// PERFORMANCE
--// =========================
local Performance = {
    BrightnessMult = 1,
    FogDensity = 0,
    ParticlesDisabled = {},
    SoundsDisabled = {},
    OriginalBrightness = Lighting.Ambient,
    OriginalOutdoor = Lighting.OutdoorAmbient,
    OriginalFogStart = Lighting.FogStart,
    OriginalFogEnd = Lighting.FogEnd,
    EffectsDisabled = {},
}

function Performance.SetBrightness(mult)
    Performance.BrightnessMult = mult / 100
    local newAmb = Performance.OriginalBrightness * (mult / 100)
    Lighting.Ambient = newAmb
    Lighting.OutdoorAmbient = newAmb
    if mult < 50 then
        Lighting.ClockTime = 6 + (mult / 100) * 12
    else
        Lighting.ClockTime = 12 + ((mult - 50) / 50) * 12
    end
end

function Performance.SetFogDensity(density)
    Performance.FogDensity = density
    if density == 0 then
        Lighting.FogStart = 0
        Lighting.FogEnd = 100000
    else
        local maxDist = 10000
        local minDist = 500
        Lighting.FogEnd = maxDist - (density * (maxDist - minDist) / 100)
        Lighting.FogStart = Lighting.FogEnd - 2000
    end
end

function Performance.DisableParticles(state)
    if state then
        for _, obj in pairs(Workspace:GetDescendants()) do
            if obj:IsA("ParticleEmitter") then
                if not Performance.ParticlesDisabled[obj] then
                    Performance.ParticlesDisabled[obj] = obj.Enabled
                end
                obj.Enabled = false
            end
        end
        for _, obj in pairs(Lighting:GetDescendants()) do
            if obj:IsA("ParticleEmitter") then
                if not Performance.ParticlesDisabled[obj] then
                    Performance.ParticlesDisabled[obj] = obj.Enabled
                end
                obj.Enabled = false
            end
        end
    else
        for obj, wasEnabled in pairs(Performance.ParticlesDisabled) do
            if obj and obj.Parent then obj.Enabled = wasEnabled end
        end
        Performance.ParticlesDisabled = {}
    end
end

function Performance.DisableSounds(state)
    if state then
        for _, obj in pairs(Workspace:GetDescendants()) do
            if obj:IsA("Sound") then
                if not Performance.SoundsDisabled[obj] then
                    Performance.SoundsDisabled[obj] = obj.Volume
                end
                obj.Volume = 0
            end
        end
        for _, obj in pairs(Lighting:GetDescendants()) do
            if obj:IsA("Sound") then
                if not Performance.SoundsDisabled[obj] then
                    Performance.SoundsDisabled[obj] = obj.Volume
                end
                obj.Volume = 0
            end
        end
    else
        for obj, origVolume in pairs(Performance.SoundsDisabled) do
            if obj and obj.Parent then obj.Volume = origVolume end
        end
        Performance.SoundsDisabled = {}
    end
end

function Performance.DisableTerrainDetails(state)
    if state then
        for _, obj in pairs(Workspace:GetDescendants()) do
            if obj:IsA("Decal") or obj:IsA("TextureId") then
                if not Performance.EffectsDisabled[obj] then
                    Performance.EffectsDisabled[obj] = obj.Transparency
                end
                obj.Transparency = 1
            elseif obj:IsA("BasePart") then
                local n = obj.Name:lower()
                if n:find("effect") or n:find("fog") or n:find("cloud") or n:find("mist") then
                    if not Performance.EffectsDisabled[obj] then
                        Performance.EffectsDisabled[obj] = obj.Transparency
                    end
                    obj.Transparency = 1
                end
            end
        end
    else
        for obj, origTransparency in pairs(Performance.EffectsDisabled) do
            if obj and obj.Parent then obj.Transparency = origTransparency end
        end
        Performance.EffectsDisabled = {}
    end
end

local insanityLoop = nil
local vignetteFrames = {}
local originalFOV = 70

function Performance.DisableInsanityEffects(state)
    if insanityLoop then insanityLoop:Disconnect() insanityLoop = nil end
    vignetteFrames = {}
    if state then
        Performance.RemoveVignette()
        Performance.DisableParticles(true)
        Performance.LockCameraFOV(true)
        insanityLoop = RunService.Heartbeat:Connect(function()
            pcall(function()
                local camera = Workspace.CurrentCamera
                if camera.FieldOfView ~= originalFOV then
                    camera.FieldOfView = originalFOV
                end
            end)
            pcall(function()
                for _, obj in pairs(Lighting:GetChildren()) do
                    if obj:FindFirstProperty("Enabled") then
                        local n = obj.Name:lower()
                        if n:find("colorcorrection") or n:find("desaturat") or n:find("bw") or n:find("grayscale") then
                            obj.Enabled = false
                        end
                    end
                end
            end)
            pcall(function()
                local playerGui = player:FindFirstChild("PlayerGui")
                if playerGui then
                    for _, screenGui in pairs(playerGui:GetChildren()) do
                        if screenGui:IsA("ScreenGui") then
                            for _, frame in pairs(screenGui:GetChildren()) do
                                if frame:IsA("Frame") or frame:IsA("ImageLabel") then
                                    local n = frame.Name:lower()
                                    if n:find("vignette") or n:find("tunnel") or n:find("overlay") or n:find("darken") or n:find("screen") or n:find("insanity") then
                                        if frame:FindFirstProperty("Visible") then frame.Visible = false end
                                        if frame:FindFirstProperty("BackgroundTransparency") then frame.BackgroundTransparency = 1 end
                                        table.insert(vignetteFrames, frame)
                                    end
                                end
                            end
                        end
                    end
                end
            end)
            pcall(function()
                for _, obj in pairs(Workspace:GetDescendants()) do
                    if obj:IsA("ParticleEmitter") then
                        local parent = obj.Parent
                        if parent then
                            local n = parent.Name:lower()
                            if n:find("effect") or n:find("flame") or n:find("particle") or n:find("insanity") then
                                obj.Enabled = false
                            end
                        end
                    end
                end
            end)
        end)
        AddConn(insanityLoop)
    else
        Performance.LockCameraFOV(false)
        if insanityLoop then insanityLoop:Disconnect() insanityLoop = nil end
    end
end

function Performance.LockCameraFOV(lock)
    local camera = Workspace.CurrentCamera
    if lock then
        originalFOV = camera.FieldOfView
        camera.FieldOfView = 70
    else
        camera.FieldOfView = 70
    end
end

function Performance.RemoveVignette()
    local playerGui = player:FindFirstChild("PlayerGui")
    if playerGui then
        for _, screenGui in pairs(playerGui:GetChildren()) do
            if screenGui:IsA("ScreenGui") then
                for _, frame in pairs(screenGui:GetChildren()) do
                    if frame:IsA("Frame") or frame:IsA("ImageLabel") then
                        local n = frame.Name:lower()
                        if n:find("vignette") or n:find("tunnel") or n:find("overlay") or n:find("insanity") then
                            frame.Visible = false
                            if frame:FindFirstProperty("BackgroundTransparency") then
                                frame.BackgroundTransparency = 1
                            end
                        end
                    end
                end
            end
        end
    end
end

function Performance.FindAllEffects()
    local report = "=== COMPLETE EFFECT SCAN ===\n\n"
    local foundItems = 0
    report = report .. "📍 LIGHTING:\n"
    for _, obj in pairs(Lighting:GetChildren()) do
        report = report .. "  • " .. obj.Name .. " (" .. obj.ClassName .. ")\n"
        foundItems += 1
    end
    report = report .. "\n📍 PLAYER GUI (Suspicious):\n"
    local playerGui = player:FindFirstChild("PlayerGui")
    if playerGui then
        for _, obj in pairs(playerGui:GetDescendants()) do
            local n = obj.Name:lower()
            if n:find("insanity") or n:find("effect") or n:find("distort") or n:find("screen") or n:find("overlay") or n:find("color") or n:find("vignette") then
                report = report .. "  • " .. obj.Name .. " (" .. obj.ClassName .. ")\n"
                foundItems += 1
            end
        end
    end
    report = report .. "\n📍 CAMERA EFFECTS:\n"
    local camera = Workspace.CurrentCamera
    report = report .. "  • FOV: " .. tostring(camera.FieldOfView) .. "\n"
    foundItems += 1
    report = report .. "\n📍 ALL SCREENGUIS:\n"
    if playerGui then
        for _, obj in pairs(playerGui:GetChildren()) do
            if obj:IsA("ScreenGui") then
                report = report .. "  • " .. obj.Name .. " (Visible: " .. tostring(obj.Visible) .. ")\n"
                foundItems += 1
            end
        end
    end
    report = report .. "\n✅ Total items found: " .. foundItems
    return report
end

function Performance.DetectAndShowEffects()
    local details = "=== DETECTED EFFECTS ===\n"
    local particleCount = 0
    local soundCount = 0
    local colorCorrectionCount = 0
    local insanityCount = 0
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("ParticleEmitter") and obj.Enabled then particleCount += 1 end
    end
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("Sound") and obj.Volume > 0 then soundCount += 1 end
    end
    for _, obj in pairs(Lighting:GetChildren()) do
        if obj.Name:find("ColorCorrection") or obj.Name:find("Insanity") then
            colorCorrectionCount += 1
            insanityCount += 1
        end
    end
    details = details .. "\n🎨 Particles: " .. particleCount
    details = details .. "\n🔊 Sounds: " .. soundCount
    details = details .. "\n📺 Color Effects: " .. colorCorrectionCount
    details = details .. "\n😵 Insanity Effects: " .. insanityCount
    return details
end

function Performance.DiscoverWholeMap()
    for _, island in pairs(ISLAND_FOLDERS) do
        task.spawn(function()
            Features.TeleportToIsland(island)
            task.wait(2)
        end)
        task.wait(0.3)
    end
    local notif = Instance.new("TextLabel")
    notif.Size = UDim2.new(0, 300, 0, 40)
    notif.Position = UDim2.new(0.5, -150, 0.85, 0)
    notif.BackgroundColor3 = Color3.fromRGB(15, 15, 22)
    notif.BackgroundTransparency = 0.2
    notif.TextColor3 = Color3.fromRGB(100, 200, 100)
    notif.Font = Enum.Font.GothamBold
    notif.TextSize = 12
    notif.Text = "🗺️ Discovering " .. #ISLAND_FOLDERS .. " islands..."
    Instance.new("UICorner", notif).CornerRadius = UDim.new(0, 8)
    notif.Parent = gui
    task.wait(15)
    notif:Destroy()
end

